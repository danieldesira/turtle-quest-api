generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model outcomes {
  id     Int      @id(map: "outcomes_pk") @default(autoincrement())
  desc   String   @db.VarChar
  scores scores[]
}

model players {
  name          String?   @db.VarChar(128)
  date_of_birth DateTime? @db.Date
  external_id   String    @db.VarChar
  platform      String    @db.VarChar
  profile_pic   String?   @db.VarChar
  last_game     Json?
  created_at    DateTime  @db.Timestamp(6)
  last_login_at DateTime? @db.Timestamp(6)
  email         String    @unique(map: "player_unique") @db.VarChar
  settings      Json?     @db.Json
  id            Int       @id(map: "player_pkey") @default(autoincrement())
  scores        scores[]
}

model scores {
  points     Int
  level      Int      @db.SmallInt
  created_at DateTime @db.Timestamp(6)
  player_id  Int?
  id         Int      @id(map: "score_pk") @default(autoincrement())
  outcome_id Int
  outcomes   outcomes @relation(fields: [outcome_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "score_outcomes_fk")
  players    players? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "score_player_fk")
}
