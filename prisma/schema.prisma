generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum OutcomeType {
  WIN
  LOSS
}

model players {
  id                    Int       @id(map: "player_pkey") @default(autoincrement())
  name                  String?   @db.VarChar(128)
  date_of_birth         DateTime? @db.Date
  profile_pic_r2_key    String?   @db.VarChar
  last_game             Json?
  created_at            DateTime  @db.Timestamp(6)
  last_login_at         DateTime? @db.Timestamp(6)
  email                 String    @unique(map: "player_unique") @db.VarChar
  settings              Json?     @db.Json
  last_game_saved_on    DateTime? @db.Timestamp(6)
  scores                scores[]
  players_sso_providers players_sso_providers[]
  external_id        String    @db.VarChar
  sso_provider       String    @db.VarChar
}

model players_sso_providers {
  id              Int    @id(map: "players_sso_provider_pkey") @default(autoincrement())
  player_id       Int
  sso_provider    String @db.VarChar
  external_id     String @db.VarChar
  players         players? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "players_sso_providers_fk")
}

model scores {
  id          Int      @id(map: "score_pk") @default(autoincrement())
  points      Int
  level       Int      @db.SmallInt
  created_at  DateTime @db.Timestamp(6)
  player_id   Int
  outcome     OutcomeType
  duration    Int
  resets_used Int
  players     players? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "score_player_fk")
}
