###
@authToken = {{googleLogin.response.headers.set-cookie}}

# @name savePoints
POST {{baseUrl}}/api/points
Accept: application/json
Content-Type: application/json
Cookie: {{authToken}}

{
  "points": 30000,
  "level": 2
}


###
# @name fetchHighScores
GET {{baseUrl}}/api/high-scores
Accept: application/json
Content-Type: application/json


###
# @name updatePlayer
PUT {{baseUrl}}/api/player
Accept: application/json
Content-Type: application/json
Cookie: {{authToken}}

{
  "name": "Daniel Desira",
  "date_of_birth": "1993-05-26",
  "settings": {
    "controlPosition": "Right"
  }
}


