@authToken = {{googleLogin.response.headers.set-cookie}}

# @name savePoints
POST {{baseUrl}}/api/points
Accept: application/json
Content-Type: application/json
Cookie: {{authToken}}

{
  "interactions": "Shrimp,1000|Sardine,10|Boat,1",
  "level": 2,
  "duration": 100,
  "remainingResets": 0
}


###
# @name fetchHighScores
GET {{baseUrl}}/api/high-scores
Accept: application/json
Content-Type: application/json


###
# @name updatePlayer
PUT {{baseUrl}}/api/player
Accept: application/json
Content-Type: application/json
Cookie: {{authToken}}

